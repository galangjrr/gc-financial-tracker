# Golang Backend Environment Configuration
PORT=8080

# Supabase PostgreSQL Connection String (Direct or Transaction Pooler from Supabase Project Settings -> Database)
# Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot (Optional for Webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET=

# Gemini Vision OCR (Optional for receipt scanner)
GEMINI_API_KEY=
